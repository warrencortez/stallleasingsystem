NODE_ENV=production
DEMO_MODE=false
CLIENT_URL=https://YOUR-WEBSITE.vercel.app
# Supabase Connect -> Transaction pooler. Copy its host/user/password, not the direct IPv6 host.
DB_HOST=YOUR-POOLER-HOST
DB_PORT=6543
DB_USER=postgres.YOUR-PROJECT-REF
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true
JWT_SECRET=
CRON_SECRET=
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server only, never put this in a VITE_ or EXPO_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=stall-uploads
SUPPORT_STORE=postgres
UPLOAD_STORAGE=supabase
AUTH_RATE_LIMIT_STORE=postgres
# Optional: leave payment variables empty to keep online payment unavailable.
PAYMENT_MODE=test
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_SUCCESS_URL=https://YOUR-API.vercel.app/payments/return
PAYMONGO_CANCEL_URL=https://YOUR-API.vercel.app/payments/return
PAYMONGO_PAYMENT_METHODS=gcash,card
