{
  "expo": {
    "name": "Dela Costa HOA Stall Leasing",
    "slug": "leasehub-tenant",
    "owner": "tealicieuxtest",
    "extra": {
      "eas": {
        "projectId": "f6fa1783-a50e-415e-bea0-ea5fa7f6fde1"
      }
    },
    "scheme": "leasehub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5"
      },
      "package": "com.leasehub.tenant"
    },
    "plugins": [
      "expo-dev-client",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "android": {
            "drawable": {
              "icon": "./assets/splashscreen.xml"
            }
          },
          "backgroundColor": "#4f46e5"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ]
  }
}
