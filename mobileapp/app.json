{
  "expo": {
    "name": "MR99 Commercial Stall Leasing",
    "slug": "leasehub-tenant",
    "owner": "mr99commercialstall",
    "scheme": "leasehub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5"
      },
      "package": "com.leasehub.tenant",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "android": {
            "drawable": {
              "icon": "./assets/splashscreen.xml"
            }
          },
          "backgroundColor": "#4f46e5"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "848d1377-ed0a-4f77-9a71-0acbb5bc20bc"
      }
    }
  }
}
